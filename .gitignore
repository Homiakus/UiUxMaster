# ==============================================================================
# UiUxMaster — Git Ignore Configuration
# ==============================================================================

# Binaries and executables
*.exe
*.exe~
*.dll
*.so
*.dylib
bin/
dist/
build/

# Go test and profiling artifacts
*.test
*.out
profile.out
coverage.out
coverage.html
pprof/

# Go workspace and caches
.cache/
vendor/

# Node / Web / Package managers
node_modules/
package-lock.json.bak
yarn-error.log*
yarn-debug.log*
npm-debug.log*
pnpm-debug.log*
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Playwright and browser test artifacts
test-results/
playwright-report/
playwright/.cache/
.playwright/
blob-report/

# Browser profiles, temporary caches, and captures
temp/
tmp/
scratch/
screenshots/
recordings/
traces/
chrome-profile*/
userDataDir*/
*.log
*.crdownload
*.webloc

# Benchmark and runtime metrics
build/benchmarks/*.raw
benchmarks/local/

# Epistemic Memory, Axiom & SkillState stores
.axiom_store/
.ep_memory_store/
.skillstate/
.agctl/
.autoloop/
.sncsincore/

# Environment variables and sensitive secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cert

# Operating System generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# IDEs, Editors & AI Agent configurations
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.zed/
.cursor/
